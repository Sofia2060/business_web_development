# Copy to .env and fill in real values. Never commit .env.
# With DB_USER empty, the backend logs in with Windows Authentication.
DB_SERVER=localhost
DB_NAME=VinoraJewelry
DB_USER=
DB_PASSWORD=
# Random text (at least 32 characters) that signs the login cookie. Make one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
